<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <!-- This manifest is used on Windows only.
       Don't remove it as it might cause problems with window transparency and embedded controls.
       For more details visit https://learn.microsoft.com/en-us/windows/win32/sbscs/application-manifests -->
  <assemblyIdentity version="1.0.0.0" name="PressViewer.Desktop"/>

  <!-- 必须以管理员身份运行。
       低层键鼠钩子（WH_KEYBOARD_LL / WH_MOUSE_LL）受 UIPI 限制：普通权限进程收不到
       更高权限进程的输入。绝区零等游戏的可执行文件 manifest 里写的是
       requestedExecutionLevel="requireAdministrator"（2026-11-28 实测确认），
       所以不把本程序提权，游戏内就完全记录不到。

       副作用：桌面快捷方式会被 Windows 叠一层 UAC 盾徽。绕法见
       SettingsViewModel.CreateDesktopShortcut：快捷方式的目标写成 powershell.exe，
       由它 runas 拉起本程序，目标不是提权 exe 就不会叠盾。 -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- A list of the Windows versions that this application has been tested on
           and is designed to work with. Uncomment the appropriate elements
           and Windows will automatically select the most compatible environment. -->

      <!-- Windows 10 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
