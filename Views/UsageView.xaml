<UserControl
  x:Class="PressViewer.Views.UsageView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource BgBrush}">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  页头  -->
    <StackPanel Grid.Row="0">
      <TextBlock Style="{StaticResource PageTitle}" Text="电脑使用统计" />
      <TextBlock
        Margin="0,5,0,0"
        Style="{StaticResource MutedText}"
        Text="来自后台 UsageTracker 服务的屏幕活动时长" />
    </StackPanel>

    <!--  今日使用时长  -->
    <Border
      Grid.Row="1"
      Margin="0,16,0,0"
      Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Style="{StaticResource CardTitle}"
          Text="今日使用时长" />
        <TextBlock
          HorizontalAlignment="Right"
          FontSize="30"
          FontWeight="SemiBold"
          Foreground="{DynamicResource AccentDeepBrush}"
          Text="{Binding TodayUsageText}" />
      </DockPanel>
    </Border>

    <!--  说明  -->
    <Border
      Grid.Row="2"
      Margin="0,10,0,0"
      Padding="14,10"
      Background="{DynamicResource AccentSoftBrush}"
      CornerRadius="10">
      <TextBlock
        FontSize="12"
        Foreground="{DynamicResource SubInkBrush}"
        Text="本页使用时长来自后台 UsageTracker 服务。服务按「会话整段记在会话开始的那一天」写入数据库；跨午夜的会话会被修正拆分到实际所属日期，因此个别日期的「修正时长」与数据库存在分钟级差异（原因见「修正原因」列），其余日期通常只有秒级计时误差。"
        TextWrapping="Wrap" />
    </Border>

    <!--  历史使用时长  -->
    <Border
      Grid.Row="3"
      Margin="0,12,0,0"
      Padding="0"
      Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock
          Margin="18,14,18,10"
          DockPanel.Dock="Top"
          Style="{StaticResource SectionTitle}"
          Text="历史使用时长" />
        <DataGrid
          Margin="0,0,0,10"
          ClipboardCopyMode="IncludeHeader"
          ItemsSource="{Binding History}"
          Style="{StaticResource DataGridFlat}">
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="120"
              Binding="{Binding Date}"
              Header="日期" />
            <DataGridTextColumn
              Width="200"
              Binding="{Binding FormattedTime}"
              Header="时长（数据库）" />
            <DataGridTextColumn
              Width="200"
              Binding="{Binding FormattedCorrectedTime}"
              Header="修正时长">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasDiscrepancy}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}" />
                      <Setter Property="FontWeight" Value="Bold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn
              Width="300"
              Binding="{Binding CorrectionReason}"
              Header="修正原因">
              <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>

    <!--  会话事件  -->
    <Border
      Grid.Row="4"
      Margin="0,12,0,0"
      Padding="0"
      Style="{StaticResource Card}">
      <DockPanel>
        <TextBlock
          Margin="18,14,18,10"
          DockPanel.Dock="Top"
          Style="{StaticResource SectionTitle}"
          Text="会话事件" />
        <DataGrid
          Margin="0,0,0,10"
          ClipboardCopyMode="IncludeHeader"
          ItemsSource="{Binding SessionEvents}"
          Style="{StaticResource DataGridFlat}">
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="160"
              Binding="{Binding Timestamp}"
              Header="时间" />
            <DataGridTextColumn
              Width="100"
              Binding="{Binding EventType}"
              Header="事件类型" />
            <DataGridTextColumn
              Width="80"
              Binding="{Binding TimeSincePrevious}"
              Header="间隔" />
            <DataGridTextColumn
              Width="150"
              Binding="{Binding FormattedCumulativeUsage}"
              Header="本次会话时长" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
