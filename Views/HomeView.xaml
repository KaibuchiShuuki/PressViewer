<UserControl
  x:Class="PressViewer.Views.HomeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:PressViewer.Views"
  d:DesignHeight="700"
  d:DesignWidth="1100"
  Background="{DynamicResource BgBrush}"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d">

  <UserControl.Resources>
    <!--  详情链接按钮  -->
    <Style
      x:Key="LinkButton"
      TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <TextBlock
              x:Name="LinkText"
              Foreground="{TemplateBinding Foreground}"
              Text="{TemplateBinding Content}" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--  统计卡大数字  -->
    <Style x:Key="BigNumberStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer
    Background="{DynamicResource BgBrush}"
    VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,28">

      <!--  页头  -->
      <Grid>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="首页" />
          <TextBlock
            Margin="0,5,0,0"
            Style="{StaticResource MutedText}"
            Text="今天的输入与使用概览" />
        </StackPanel>
      </Grid>

      <!--  四张统计卡  -->
      <UniformGrid
        Margin="0,18,0,0"
        Columns="4">
        <!--  鼠标点击  -->
        <Border
          MinHeight="158"
          Margin="0,0,12,0"
          Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource CardTitle}" Text="鼠标点击记录" />
              <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Ellipse
                  Width="7"
                  Height="7"
                  Margin="0,0,6,0"
                  Fill="{Binding MouseRecordingColor}" />
                <TextBlock
                  FontSize="11"
                  Foreground="{Binding MouseRecordingColor}"
                  Text="{Binding MouseRecordingStatus}" />
              </StackPanel>
            </Grid>
            <TextBlock
              Margin="0,14,0,2"
              Style="{StaticResource BigNumberStyle}"
              Text="{Binding MouseTodayClicks, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource MutedText}" Text="今日点击" />
            <Grid Margin="0,12,0,0">
              <TextBlock Style="{StaticResource MutedText}" Text="{Binding MouseTotalClicks, Converter={StaticResource Thousands}, StringFormat='累计 {0}'}" />
              <Button
                HorizontalAlignment="Right"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="ClickCounter"
                Content="详情"
                Style="{StaticResource LinkButton}" />
            </Grid>
          </StackPanel>
        </Border>

        <!--  键盘按键  -->
        <Border
          MinHeight="158"
          Margin="0,0,12,0"
          Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource CardTitle}" Text="键盘按键记录" />
              <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Ellipse
                  Width="7"
                  Height="7"
                  Margin="0,0,6,0"
                  Fill="{Binding KeyRecordingColor}" />
                <TextBlock
                  FontSize="11"
                  Foreground="{Binding KeyRecordingColor}"
                  Text="{Binding KeyRecordingStatus}" />
              </StackPanel>
            </Grid>
            <TextBlock
              Margin="0,14,0,2"
              Style="{StaticResource BigNumberStyle}"
              Text="{Binding KeyTodayPresses, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource MutedText}" Text="今日按键" />
            <Grid Margin="0,12,0,0">
              <TextBlock Style="{StaticResource MutedText}" Text="{Binding KeyTotalPresses, Converter={StaticResource Thousands}, StringFormat='累计 {0}'}" />
              <Button
                HorizontalAlignment="Right"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="KeyCounter"
                Content="详情"
                Style="{StaticResource LinkButton}" />
            </Grid>
          </StackPanel>
        </Border>

        <!--  手柄按键  -->
        <Border
          MinHeight="158"
          Margin="0,0,12,0"
          Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource CardTitle}" Text="手柄按键记录" />
              <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Ellipse
                  Width="7"
                  Height="7"
                  Margin="0,0,6,0"
                  Fill="{Binding GamepadRecordingColor}" />
                <TextBlock
                  FontSize="11"
                  Foreground="{Binding GamepadRecordingColor}"
                  Text="{Binding GamepadRecordingStatus}" />
              </StackPanel>
            </Grid>
            <TextBlock
              Margin="0,14,0,2"
              Style="{StaticResource BigNumberStyle}"
              Text="{Binding GamepadTodayPresses, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource MutedText}" Text="今日按键" />
            <Grid Margin="0,12,0,0">
              <TextBlock Style="{StaticResource MutedText}" Text="{Binding GamepadTotalPresses, Converter={StaticResource Thousands}, StringFormat='累计 {0}'}" />
              <Button
                HorizontalAlignment="Right"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="GamepadCounter"
                Content="详情"
                Style="{StaticResource LinkButton}" />
            </Grid>
          </StackPanel>
        </Border>

        <!--  使用时长  -->
        <Border MinHeight="158" Style="{StaticResource Card}">
          <StackPanel>
            <Grid>
              <TextBlock Style="{StaticResource CardTitle}" Text="电脑使用" />
            </Grid>
            <TextBlock
              Margin="0,14,0,2"
              Style="{StaticResource BigNumberStyle}"
              Text="{Binding TodayUsageText}" />
            <TextBlock Style="{StaticResource MutedText}" Text="今日使用时长" />
            <Grid Margin="0,12,0,0">
              <TextBlock Style="{StaticResource MutedText}" Text="按屏幕活动统计" />
              <Button
                HorizontalAlignment="Right"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="Usage"
                Content="详情"
                Style="{StaticResource LinkButton}" />
            </Grid>
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  热力图模块  -->
      <Border
        Margin="0,16,0,0"
        Cursor="Hand"
        MouseLeftButtonUp="OnHeatmapCardClick"
        Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTitle}" Text="热力图" />
              <TextBlock
                Margin="0,4,0,0"
                Style="{StaticResource MutedText}"
                Text="全部时间 · 键盘按键分布与鼠标点击" />
            </StackPanel>

            <StackPanel
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Orientation="Horizontal">
              <Border
                Margin="0,0,8,0"
                Padding="10,6"
                Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="8">
                <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource AccentDeepBrush}"
                  Text="{Binding MouseLeftTotal, Converter={StaticResource Thousands}, StringFormat='左键 {0}'}" />
              </Border>
              <Border
                Margin="0,0,8,0"
                Padding="10,6"
                Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="8">
                <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource AccentDeepBrush}"
                  Text="{Binding MouseMiddleTotal, Converter={StaticResource Thousands}, StringFormat='中键 {0}'}" />
              </Border>
              <Border
                Margin="0,0,14,0"
                Padding="10,6"
                Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="8">
                <TextBlock
                  FontSize="12"
                  Foreground="{DynamicResource AccentDeepBrush}"
                  Text="{Binding MouseRightTotal, Converter={StaticResource Thousands}, StringFormat='右键 {0}'}" />
              </Border>
              <Button
                VerticalAlignment="Center"
                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="Heatmap"
                Content="查看详情"
                Style="{StaticResource LinkButton}" />
            </StackPanel>
          </DockPanel>

          <views:KeyboardHeatmapView
            Grid.Row="1"
            Height="300"
            Margin="0,12,0,0"
            ItemsSource="{Binding HeatmapKeys}" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
