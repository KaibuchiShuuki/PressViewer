<UserControl
  x:Class="PressViewer.Views.KeyboardHeatmapView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid
    Background="Transparent"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  汇总  -->
    <TextBlock
      x:Name="SummaryText"
      Grid.Row="0"
      Margin="16,10,16,0"
      HorizontalAlignment="Right"
      FontSize="12"
      Foreground="{DynamicResource MutedBrush}"
      Text="总计 0 次" />

    <!--  键盘本体：固定坐标系，按可用空间手工等比缩放  -->
    <Border
      x:Name="BoardHost"
      Grid.Row="1"
      Margin="16,6,16,6"
      HorizontalAlignment="Stretch"
      VerticalAlignment="Stretch"
      ClipToBounds="True">
      <Canvas
        x:Name="BoardCanvas"
        Width="1098"
        Height="311"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="Transparent" />
    </Border>

    <!--  色阶图例  -->
    <StackPanel
      Grid.Row="2"
      Margin="16,0,16,12"
      Orientation="Horizontal">
      <TextBlock
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource MutedBrush}"
        Text="少" />
      <Border
        x:Name="LegendBar"
        Width="150"
        Height="8"
        Margin="6,0"
        CornerRadius="4" />
      <TextBlock
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource MutedBrush}"
        Text="多" />
      <TextBlock
        Margin="14,0,0,0"
        VerticalAlignment="Center"
        FontSize="11"
        Foreground="{DynamicResource MutedBrush}"
        Text="颜色按相对次数映射 · 键帽右下角为累计次数" />
    </StackPanel>
  </Grid>
</UserControl>
