<UserControl
  x:Class="PressViewer.Views.LogViewerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource BgBrush}">

  <Grid Margin="30,26,30,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!--  页头  -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="应用日志" />
        <TextBlock
          Margin="0,6,0,0"
          Style="{StaticResource MutedText}"
          Text="运行记录，最新一条在底部；级别筛选只影响显示。" />
      </StackPanel>

      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Orientation="Horizontal">
        <ComboBox
          Width="132"
          ItemsSource="{Binding AvailableLevels}"
          SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />
        <Button
          Margin="10,0,0,0"
          Command="{Binding ClearLogsCommand}"
          Content="清空" />
      </StackPanel>
    </Grid>

    <!--  日志表  -->
    <Border
      Grid.Row="1"
      Padding="6"
      Style="{StaticResource Card}">
      <ListView
        Background="Transparent"
        BorderThickness="0"
        ItemsSource="{Binding FilteredLogs}"
        VirtualizingPanel.ScrollUnit="Pixel"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <ListView.View>
          <GridView>
            <GridViewColumn
              Width="180"
              DisplayMemberBinding="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}"
              Header="时间" />
            <GridViewColumn
              Width="90"
              DisplayMemberBinding="{Binding Level}"
              Header="级别" />
            <GridViewColumn
              Width="150"
              DisplayMemberBinding="{Binding SourceContext}"
              Header="来源" />
            <GridViewColumn
              Width="640"
              DisplayMemberBinding="{Binding Message}"
              Header="消息" />
          </GridView>
        </ListView.View>
      </ListView>
    </Border>
  </Grid>
</UserControl>
