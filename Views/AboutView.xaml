<UserControl
  x:Class="PressViewer.Views.AboutView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Background="{DynamicResource BgBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel
      MaxWidth="820"
      Margin="24,20,24,28"
      HorizontalAlignment="Left">

      <!--  页头  -->
      <TextBlock Style="{StaticResource PageTitle}" Text="关于" />
      <TextBlock
        Margin="0,5,0,0"
        Style="{StaticResource MutedText}"
        Text="版本信息与更新日志" />

      <!--  版本  -->
      <Border
        Margin="0,16,0,0"
        Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock
            x:Name="AboutVersionText"
            Style="{StaticResource SectionTitle}"
            Text="{Binding VersionText}" />
          <TextBlock
            Margin="0,6,0,0"
            Style="{StaticResource MutedText}"
            Text="作者 KaibuchiShuuki · 基于 XAssistant（原作者 xuhk）" />
          <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedText}">
            <Hyperlink
              NavigateUri="https://github.com/KaibuchiShuuki/PressViewer"
              RequestNavigate="OnRepoLinkNavigate">
              <Hyperlink.Style>
                <Style TargetType="Hyperlink">
                  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                  <Setter Property="TextDecorations" Value="Underline" />
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Hyperlink.Style>
              <Run Text="https://github.com/KaibuchiShuuki/PressViewer" />
            </Hyperlink>
          </TextBlock>
          <StackPanel
            Margin="0,14,0,0"
            Orientation="Horizontal">
            <Button
              x:Name="AboutCheckUpdateButton"
              MinWidth="110"
              Height="34"
              Command="{Binding CheckUpdateCommand}"
              Content="{Binding UpdateButtonText}"
              IsEnabled="{Binding CanCheckUpdate}"
              Style="{StaticResource AccentButton}" />
            <TextBlock
              x:Name="AboutUpdateStatusText"
              Margin="12,0,0,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource MutedBrush}"
              Text="{Binding UpdateStatusText}"
              TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!--  更新日志  -->
      <Border
        Margin="0,16,0,0"
        Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="更新日志" />
          <ItemsControl
            x:Name="AboutChangelog"
            Margin="0,12,0,0"
            ItemsSource="{Binding Changelog}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,16">
                  <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource InkBrush}"
                    Text="{Binding Title}" />
                  <ItemsControl Margin="12,6,0,0" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,8">
                          <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SubInkBrush}"
                            Text="{Binding Name}" />
                          <ItemsControl Margin="12,2,0,0" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock
                                  Margin="0,2"
                                  FontSize="13"
                                  Foreground="{DynamicResource SubInkBrush}"
                                  TextWrapping="Wrap">
                                  <Run Text="• " />
                                  <Run Text="{Binding Mode=OneWay}" />
                                </TextBlock>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
