<UserControl
  x:Class="PressViewer.Views.GamepadCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:conv="clr-namespace:PressViewer.Converters"
  Background="{DynamicResource BgBrush}">
  <UserControl.Resources>
    <conv:GamepadButtonNameConverter x:Key="GamepadName" />
    <conv:InvertableBooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,22,28,24">
      <DockPanel>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="手柄按键记录" />
          <TextBlock
            Margin="0,4,0,0"
            Style="{StaticResource MutedText}"
            Text="XInput 手柄各按键的累计与今日次数" />
        </StackPanel>
        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Ellipse
            Width="7"
            Height="7"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Fill="{Binding GamepadRecordingColor}" />
          <TextBlock
            Margin="0,0,14,0"
            VerticalAlignment="Center"
            Style="{StaticResource MutedText}"
            Text="{Binding GamepadRecordingStatus}" />
          <Button
            Height="34"
            Margin="0,0,8,0"
            Command="{Binding StartRecordingCommand}"
            Content="开始记录"
            Style="{StaticResource AccentButton}"
            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
          <Button
            Height="34"
            Command="{Binding StopRecordingCommand}"
            Content="停止记录"
            Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </DockPanel>

      <UniformGrid Margin="0,18,0,0" Columns="3">
        <Border Margin="0,0,12,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="累计按键" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="30"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentDeepBrush}"
              Text="{Binding GamepadTotalPresses, Converter={StaticResource Thousands}}" />
          </StackPanel>
        </Border>
        <Border Margin="0,0,12,0" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="今日按键" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="30"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentDeepBrush}"
              Text="{Binding GamepadTodayPresses, Converter={StaticResource Thousands}}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource MutedText}" Text="已覆盖按键" />
            <TextBlock
              Margin="0,6,0,0"
              FontSize="30"
              FontWeight="SemiBold"
              Foreground="{DynamicResource AccentDeepBrush}"
              Text="{Binding CoveredGamepadButtons}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Grid Margin="0,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="12" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock
              DockPanel.Dock="Top"
              Margin="0,0,0,10"
              Style="{StaticResource SectionTitle}"
              Text="累计" />
            <DataGrid
              MaxHeight="360"
              ItemsSource="{Binding GamepadCounts}"
              Style="{StaticResource DataGridFlat}">
              <DataGrid.Columns>
                <DataGridTextColumn
                  Width="*"
                  Binding="{Binding Key, Converter={StaticResource GamepadName}}"
                  Header="按键" />
                <DataGridTextColumn
                  Width="120"
                  Binding="{Binding Count, Converter={StaticResource Thousands}}"
                  Header="次数" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel>
            <TextBlock
              DockPanel.Dock="Top"
              Margin="0,0,0,10"
              Style="{StaticResource SectionTitle}"
              Text="今天" />
            <DataGrid
              MaxHeight="360"
              ItemsSource="{Binding TodayGamepadCounts}"
              Style="{StaticResource DataGridFlat}">
              <DataGrid.Columns>
                <DataGridTextColumn
                  Width="*"
                  Binding="{Binding Key, Converter={StaticResource GamepadName}}"
                  Header="按键" />
                <DataGridTextColumn
                  Width="120"
                  Binding="{Binding Count, Converter={StaticResource Thousands}}"
                  Header="次数" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Border>
      </Grid>

      <Border Margin="0,16,0,0" Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource SectionTitle}"
              Text="查看历史" />
            <TextBlock
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              Style="{StaticResource MutedText}"
              Text="{Binding HistoryTotal, Converter={StaticResource Thousands}, StringFormat='当天共 {0} 次'}" />
            <DatePicker
              Width="150"
              Margin="16,0,0,0"
              HorizontalAlignment="Left"
              SelectedDate="{Binding SelectedDate}" />
          </DockPanel>
          <DataGrid
            MaxHeight="300"
            ItemsSource="{Binding HistoryGamepadCounts}"
            Style="{StaticResource DataGridFlat}">
            <DataGrid.Columns>
              <DataGridTextColumn
                Width="*"
                Binding="{Binding Key, Converter={StaticResource GamepadName}}"
                Header="按键" />
              <DataGridTextColumn
                Width="120"
                Binding="{Binding Count, Converter={StaticResource Thousands}}"
                Header="次数" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
