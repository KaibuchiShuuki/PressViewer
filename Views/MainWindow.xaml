<Window
  x:Class="PressViewer.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="PressViewer"
  Icon="/Assets/app-icon.ico"
  Width="{Binding WindowWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
  Height="{Binding WindowHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
  Background="{DynamicResource BgBrush}"
  FontFamily="Segoe UI, Microsoft YaHei UI"
  WindowStartupLocation="CenterScreen">

  <DockPanel>
    <!--  左侧栏  -->
    <Border
      Width="216"
      Background="{DynamicResource CardBrush}"
      BorderBrush="{DynamicResource CardBorderBrush}"
      BorderThickness="0,0,1,0"
      DockPanel.Dock="Left">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  品牌区  -->
        <StackPanel
          Grid.Row="0"
          Margin="24,26,24,18"
          Orientation="Horizontal">
          <Image
            Width="30"
            Height="30"
            Margin="0,0,10,0"
            Source="/Assets/logo.png"
            SnapsToDevicePixels="True" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock
              FontSize="19"
              FontWeight="SemiBold"
              Foreground="{DynamicResource InkBrush}"
              Text="PressViewer" />
            <TextBlock
              Margin="0,3,0,0"
              FontSize="11.5"
              Foreground="{DynamicResource MutedBrush}"
              Text="输入与使用统计" />
          </StackPanel>
        </StackPanel>

        <!--  导航  -->
        <ListBox
          x:Name="NavList"
          Grid.Row="1"
          Background="Transparent"
          BorderThickness="0"
          ItemContainerStyle="{StaticResource NavItemStyle}"
          SelectedValue="{Binding CurrentPage, Mode=TwoWay}"
          SelectedValuePath="Tag">
          <ListBoxItem
            Content="首页"
            Tag="Home" />
          <ListBoxItem
            Content="热力图"
            Tag="Heatmap" />
          <ListBoxItem
            Content="鼠标点击记录"
            Tag="ClickCounter" />
          <ListBoxItem
            Content="键盘按键记录"
            Tag="KeyCounter" />
          <ListBoxItem
            Content="手柄按键记录"
            Tag="GamepadCounter" />
          <ListBoxItem
            Content="电脑使用统计"
            Tag="Usage" />
          <ListBoxItem
            Content="软件使用"
            Tag="AppUsage" />
          <ListBoxItem
            Content="应用日志"
            Tag="Logs" />
          <ListBoxItem
            Content="设置"
            Tag="Settings" />
          <ListBoxItem
            Margin="12,20,12,2"
            Content="关于"
            Tag="About" />
        </ListBox>

        <!--  底部版本号  -->
        <TextBlock
          Grid.Row="2"
          Margin="24,10,24,18"
          FontSize="11.5"
          Foreground="{DynamicResource MutedBrush}"
          Text="{Binding VersionText, StringFormat=v{0}}" />
      </Grid>
    </Border>

    <!--  右侧内容区  -->
    <ContentControl Content="{Binding CurrentViewModel}" />
  </DockPanel>
</Window>
