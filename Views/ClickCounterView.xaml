<UserControl
  x:Class="PressViewer.Views.ClickCounterView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:converters="clr-namespace:PressViewer.Converters"
  Background="{DynamicResource BgBrush}">
  <UserControl.Resources>
    <converters:InverseBoolConverter x:Key="InverseBool" />

    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="MinHeight" Value="104" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentDeepBrush}" />
    </Style>

    <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="Margin" Value="0,3,0,0" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,28">

      <!--  页头  -->
      <DockPanel>
        <StackPanel>
          <TextBlock Style="{StaticResource PageTitle}" Text="鼠标点击记录" />
          <TextBlock
            Margin="0,5,0,0"
            Style="{StaticResource MutedText}"
            Text="左键、中键、右键的累计与每日分布" />
        </StackPanel>

        <StackPanel
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          Orientation="Horizontal">
          <Button
            MinWidth="112"
            Height="34"
            Margin="0,0,8,0"
            Command="{Binding StartRecordingCommand}"
            Content="开始记录"
            IsEnabled="{Binding IsRecording, Converter={StaticResource InverseBool}}"
            Style="{StaticResource AccentButton}" />
          <Button
            MinWidth="112"
            Height="34"
            Command="{Binding StopRecordingCommand}"
            Content="停止记录"
            IsEnabled="{Binding IsRecording}" />
        </StackPanel>
      </DockPanel>

      <!--  总计  -->
      <TextBlock
        Margin="0,20,0,10"
        Style="{StaticResource SectionTitle}"
        Text="总计" />
      <UniformGrid Columns="3">
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding LeftClickCount, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding MiddleClickCount, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding RightClickCount, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="右键" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  今天  -->
      <TextBlock
        Margin="0,22,0,10"
        Style="{StaticResource SectionTitle}"
        Text="今天" />
      <UniformGrid Columns="3">
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding LeftClickToday, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="左键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding MiddleClickToday, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="中键" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource StatCard}">
          <StackPanel>
            <TextBlock Style="{StaticResource StatNumber}" Text="{Binding RightClickToday, Converter={StaticResource Thousands}}" />
            <TextBlock Style="{StaticResource StatLabel}" Text="右键" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!--  历史  -->
      <Border
        Margin="0,22,0,0"
        Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock
              Margin="0,0,0,10"
              Style="{StaticResource SectionTitle}"
              Text="查看历史" />
            <Calendar
              DisplayMode="Month"
              IsTodayHighlighted="True"
              SelectedDate="{Binding SelectedDate}" />
          </StackPanel>

          <StackPanel
            Grid.Column="1"
            Margin="22,0,0,0"
            VerticalAlignment="Top">
            <TextBlock
              Style="{StaticResource CardTitle}"
              Text="{Binding SelectedDate, StringFormat='{}{0:yyyy 年 M 月 d 日}'}" />
            <UniformGrid
              Margin="0,14,0,0"
              Columns="3">
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SelectedDateLeftCount, Converter={StaticResource Thousands}}" />
                  <TextBlock Style="{StaticResource StatLabel}" Text="左键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SelectedDateMiddleCount, Converter={StaticResource Thousands}}" />
                  <TextBlock Style="{StaticResource StatLabel}" Text="中键" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Style="{StaticResource StatNumber}" Text="{Binding SelectedDateRightCount, Converter={StaticResource Thousands}}" />
                  <TextBlock Style="{StaticResource StatLabel}" Text="右键" />
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
