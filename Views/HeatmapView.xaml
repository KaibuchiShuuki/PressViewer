<UserControl
  x:Class="PressViewer.Views.HeatmapView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:PressViewer.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource BgBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.35*" MinHeight="160" />
      <RowDefinition Height="1.15*" MinHeight="230" />
    </Grid.RowDefinitions>

    <!--  页头：标题 + 范围下拉  -->
    <DockPanel
      Grid.Row="0"
      Margin="24,18,24,0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Style="{StaticResource PageTitle}" Text="热力图" />
        <TextBlock
          Margin="0,4,0,0"
          Style="{StaticResource MutedText}"
          Text="键盘、鼠标与手柄的相对热度" />
      </StackPanel>

      <StackPanel
        HorizontalAlignment="Right"
        VerticalAlignment="Center"
        DockPanel.Dock="Right"
        Orientation="Horizontal">
        <ComboBox
          Width="150"
          VerticalAlignment="Center"
          ItemsSource="{Binding RangeOptions}"
          SelectedIndex="{Binding ModeIndex, Mode=TwoWay}" />
      </StackPanel>
    </DockPanel>

    <!--  自定义日期范围（仅在“自定义…”时出现）  -->
    <Border
      Grid.Row="1"
      Margin="24,12,24,0"
      Padding="14,10"
      Style="{StaticResource Card}"
      Visibility="{Binding IsCustomMode, Converter={StaticResource BoolToVis}}">
      <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          Style="{StaticResource MutedText}"
          Text="起" />
        <DatePicker
          Width="140"
          SelectedDate="{Binding StartDate, Mode=TwoWay}" />
        <TextBlock
          Margin="12,0,6,0"
          VerticalAlignment="Center"
          Style="{StaticResource MutedText}"
          Text="止" />
        <DatePicker
          Width="140"
          SelectedDate="{Binding EndDate, Mode=TwoWay}" />
        <Button
          Margin="12,0,0,0"
          Click="OnApplyCustomRange"
          Content="应用" />
        <TextBlock
          Margin="12,0,0,0"
          VerticalAlignment="Center"
          Style="{StaticResource MutedText}"
          Text="选好起止日期后点应用" />
      </StackPanel>
    </Border>

    <!--  键盘热图  -->
    <Border
      Grid.Row="2"
      Margin="24,14,24,0"
      Padding="4"
      Style="{StaticResource Card}">
      <views:KeyboardHeatmapView ItemsSource="{Binding Keys}" />
    </Border>

    <!--  下半区：左鼠标、右手柄  -->
    <Grid
      Grid.Row="3"
      Margin="24,14,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0.4*" />
        <ColumnDefinition Width="0.6*" />
      </Grid.ColumnDefinitions>

      <Border
        Grid.Column="0"
        Margin="0,0,12,0"
        Padding="16,12"
        Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource SectionTitle}"
              Text="鼠标点击" />
            <TextBlock
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Style="{StaticResource MutedText}"
              Text="{Binding MouseTotalText}" />
          </DockPanel>
          <TextBlock
            Margin="0,2,0,0"
            DockPanel.Dock="Bottom"
            HorizontalAlignment="Center"
            Style="{StaticResource MutedText}"
            Text="{Binding MouseLegendText}" />
          <Viewbox
            Margin="0,6"
            Stretch="Uniform">
            <views:MouseShapeView ItemsSource="{Binding MouseShapeItems}" />
          </Viewbox>
        </DockPanel>
      </Border>

      <Border
        Grid.Column="1"
        Padding="16,12"
        Style="{StaticResource Card}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <TextBlock
              VerticalAlignment="Center"
              Style="{StaticResource SectionTitle}"
              Text="手柄按键" />
            <TextBlock
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Style="{StaticResource MutedText}"
              Text="{Binding Gamepad.GamepadTotalPresses, Converter={StaticResource Thousands}, StringFormat='总计 {0} 次'}" />
          </DockPanel>
          <Viewbox
            Margin="0,4"
            Stretch="Uniform">
            <views:GamepadShapeView ItemsSource="{Binding Gamepad.GamepadCounts}" />
          </Viewbox>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
